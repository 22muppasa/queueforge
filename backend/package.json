{
  "name": "@queueforge/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx watch src/index.ts api",
    "dev:worker": "tsx watch src/index.ts worker",
    "start:api": "node dist/index.js api",
    "start:worker": "node dist/index.js worker",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "prom-client": "15.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
